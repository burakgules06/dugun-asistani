# Bu dosyayi ".env" olarak kopyalayip gercek degerlerle doldurun.
# ".env" asla commit edilmemeli (.gitignore zaten haric tutuyor).

POSTGRES_DB=dugun
POSTGRES_USER=dugun_app
POSTGRES_PASSWORD=

# Meta (WhatsApp Cloud API) webhook dogrulama sirasinda kullandiginiz gizli deger.
# Meta Geliştirici Konsolu > WhatsApp > Configuration > Webhook > Verify Token alanina
# BIREBIR AYNI degeri girmeniz gerekir.
WA_VERIFY_TOKEN=

# Web Push (VAPID) - panel bildirimleri icin. Bos birakilirsa push bildirimleri devre disi kalir.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:destek@ornek.com

# JWT imzalama anahtari - en az 32 karakter olmali.
JWT_SECRET=
